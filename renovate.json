{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:earlyMondays"
  ],
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "packageRules": [
    {
      "description": "Group all non-major npm updates into a single weekly PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major npm dependencies"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Playwright's image tag and the package must move together, and the baselines with them",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright",
      "automerge": false
    }
  ]
}
